# Pinned toolchain of the Labelle WASM builder image (labelle-cli#529).
#
# The single source of truth: the Dockerfile sources this file in every RUN
# step that installs something, the workflow reads IMAGE_VERSION from it, and
# the image keeps a copy at /opt/labelle/versions.env next to the measured
# inventory (/opt/labelle/toolchain-inventory.json).
#
# Plain KEY=value lines only (sourced by bash and parsed by the workflow): no
# spaces around `=`, no quotes, no expansions, no spaces in values (lists are
# comma separated). Per-architecture values end in _amd64 / _arm64 (Docker's
# TARGETARCH names); the Dockerfile picks them with ${!name}.
#
# Bumping any value below is an image release: raise IMAGE_REVISION (or reset
# it to 1 when LABELLE_CLI_VERSION changes); see docs/wasm-builder-image.md
# "Upgrading". Every checksum here was recomputed from a download of the
# published file when it was pinned.

# Image version = <labelle CLI version>-<image revision>, e.g. 4.1.2-2. The
# CLI version leads because labelle.lock's .cli_version is what a consumer
# matches against (see "Image and toolkit compatibility" in the docs).
IMAGE_REVISION=2

# ── Ubuntu packages ─────────────────────────────────────────────────────
# apt reads snapshot.ubuntu.com at this instant (noble, noble-updates,
# noble-security; main + universe), over http with the archive's signatures
# checked, so the same revision always installs the same .debs. The snapshot
# carries amd64 and arm64 (ports) alike. Top-level packages are also pinned
# to the snapshot's version (same on both architectures); their dependencies
# and Playwright's --with-deps libraries resolve from the same snapshot.
UBUNTU_SNAPSHOT=20261030T000000Z
APT_PACKAGES=ca-certificates=20260816ubuntu0.24.04.1,curl=8.5.0-2ubuntu10.16,git=1:2.43.0-1ubuntu7.4,xz-utils=5.6.1+really5.4.5-1ubuntu0.4,bzip2=1.0.8-5.1ubuntu0.1,unzip=6.0-28ubuntu4.1,python3=3.12.3-0ubuntu2.1,python3-venv=3.12.3-0ubuntu2.1,libatomic1=14.2.0-4ubuntu2~24.04.1

# ── labelle CLI ─────────────────────────────────────────────────────────
# https://releases.labelle.games/cli/v<ver>/labelle-linux-<x86_64|arm64>.
# amd64: same version and checksum as Flying Platform's labelle.lock
# (.cli_version) and tools/ci/ensure-tool.sh. arm64: the release's
# labelle-linux-arm64 (the CLI publishes no checksum file; recomputed).
LABELLE_CLI_VERSION=4.1.2
LABELLE_CLI_ASSET_amd64=labelle-linux-x86_64
LABELLE_CLI_ASSET_arm64=labelle-linux-arm64
LABELLE_CLI_SHA256_amd64=43d84d3b19d49732646a11ad0302c4863b04bc5ee0d278679a70e4cfc1712d28
LABELLE_CLI_SHA256_arm64=6f4e33aca117f8dfddc79e830ceca9ab014db7634720b0815054db187f1f4fa1

# ── labelle-assembler (a SEED) ──────────────────────────────────────────
# The CLI still resolves the assembler from project.labelle's
# .assembler_version; when it equals this version labelle-builder-check puts
# the image's verified copy into the cache instead of a download. Checksums
# from the release's SHA256SUMS (and recomputed).
LABELLE_ASSEMBLER_VERSION=0.124.0
LABELLE_ASSEMBLER_ASSET_amd64=labelle-assembler-linux-x86_64
LABELLE_ASSEMBLER_ASSET_arm64=labelle-assembler-linux-aarch64
LABELLE_ASSEMBLER_SHA256_amd64=4d169a6cf9e5dcc006294efe986c4ac02fcd24aa7806eea9b01b4ad19dd3260b
LABELLE_ASSEMBLER_SHA256_arm64=7842c026b51d198da6de9ddfafa8ae20c3ab20254400b8c506f5ee355b82d5af

# ── Zig ─────────────────────────────────────────────────────────────────
# https://ziglang.org/download/<ver>/zig-<arch>-linux-<ver>.tar.xz; checksums
# from ziglang.org/download/index.json (and recomputed). = labelle-cli's
# DEFAULT_ZIG_VERSION / minimum_zig_version and FP's ensure-tool.sh.
ZIG_VERSION=0.16.0
ZIG_ARCH_amd64=x86_64
ZIG_ARCH_arm64=aarch64
ZIG_SHA256_amd64=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ZIG_SHA256_arm64=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17

# ── emsdk / Emscripten / Node ───────────────────────────────────────────
# labelle-web's default emsdk.version and pinned tag commit (labelle-web
# src/provider/emsdk.zig default_version/default_commit, v0.4.0). The emsdk
# tag maps 4.0.9 to the emscripten-releases build EMSDK_RELEASE_HASH; the
# Dockerfile downloads that build's archive and emsdk's Node, verifies them
# here and puts them where `emsdk install` finds them, so emsdk itself
# downloads nothing. Node checksums match nodejs.org's SHASUMS256.
EMSDK_VERSION=4.0.9
EMSDK_COMMIT=3bcf1dcd01f040f370e10fe673a092d9ed79ebb5
EMSDK_RELEASE_HASH=cb2a69bce627bd2247624c71fc12907cb8785d2f
EMSDK_ARCHIVE_amd64=wasm-binaries.tar.xz
EMSDK_ARCHIVE_arm64=wasm-binaries-arm64.tar.xz
EMSDK_ARCHIVE_SHA256_amd64=c6fd245138e6bbdd8349963cb4045c557d657e4be0ea44155375633c689c8be9
EMSDK_ARCHIVE_SHA256_arm64=872d7f5870f1bfc523a446ca66ab1b47009a96be33c398dbbb12a56597e46ab5
EMSDK_NODE_VERSION=20.18.0
EMSDK_NODE_ARCHIVE_amd64=node-v20.18.0-linux-x64.tar.xz
EMSDK_NODE_ARCHIVE_arm64=node-v20.18.0-linux-arm64.tar.xz
EMSDK_NODE_SHA256_amd64=4543670b589593f8fa5f106111fd5139081da42bb165a9239f05195e405f240a
EMSDK_NODE_SHA256_arm64=a9ce85675ba33f00527f6234d90000946c0936fb4fca605f1891bb5f4fe6fb0a
# labelle-web releases whose default emsdk.version is EMSDK_VERSION (comma
# separated). labelle-builder-check warns when labelle.lock pins another one:
# its default may have moved, and the provider passes the image's EMSDK
# through without comparing versions.
LABELLE_WEB_VERSIONS=0.4.0

# ── Chromium WASM smoke ─────────────────────────────────────────────────
# Flying Platform's tools/web_smoke/requirements.txt. Installed with
# --require-hashes from web-smoke-requirements.lock (both architectures'
# wheels, transitive deps included).
PLAYWRIGHT_VERSION=1.64.1
PILLOW_VERSION=11.3.0
# Playwright 1.64.1's browsers.json: Chrome for Testing headless shell
# (H.264 capable) and its ffmpeg. The Dockerfile fetches these from
# cdn.playwright.dev, verifies them, and serves them to `playwright install
# --only-shell chromium` from a local mirror, so Playwright installs exactly
# these bytes.
PLAYWRIGHT_CHROMIUM_VERSION=156.0.8078.4
PLAYWRIGHT_CHROMIUM_REVISION=1248
PLAYWRIGHT_SHELL_PATH_amd64=builds/cft/156.0.8078.4/linux64/chrome-headless-shell-linux64.zip
PLAYWRIGHT_SHELL_PATH_arm64=builds/cft/156.0.8078.4/linux-arm64/chrome-headless-shell-linux-arm64.zip
PLAYWRIGHT_SHELL_SHA256_amd64=c3e50596aef52c58f8fda3c6b3411c33d34c88b177b3ed1c2243359fd3b8ba20
PLAYWRIGHT_SHELL_SHA256_arm64=81ab9d4d3c301dc5fdfb6c541b9e6632b16fc819a6a854460f40a76fe2b2c476
PLAYWRIGHT_FFMPEG_PATH_amd64=builds/ffmpeg/1013/ffmpeg-linux.zip
PLAYWRIGHT_FFMPEG_PATH_arm64=builds/ffmpeg/1013/ffmpeg-linux-arm64.zip
PLAYWRIGHT_FFMPEG_SHA256_amd64=ee986434d158f74fb5d9c5ff1092026ceedb63f324fe90b5be89460926b7b679
PLAYWRIGHT_FFMPEG_SHA256_arm64=457360e803a7d8d5f8f7f5ecf562b2d338f6b4f7f86339d0c31938a451e8878b
