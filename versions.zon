.{
    // The current tested-compatible set `labelle upgrade all` targets. The
    // packages version on INDEPENDENT minor trains (the assembler unifies them
    // onto the project's core at build time), so these minors differ by design.
    // Bump to the latest releases as they're cut + CI-verified together.
    .core = "2.0.0",
    .engine = "3.0.0",
    .gfx = "2.0.0",
    // The bgfx backend package. gfx and bgfx MUST move together: bgfx 0.21.0
    // implements the game-owned shader-material contract of core 2.0.0 /
    // gfx 2.0.0 (MATERIAL_CONTRACT_VERSION 2). `upgrade all` writing a 2.x gfx
    // while leaving the backend pin on 0.20.0 (which names the RETIRED
    // pixel-water contract) produces
    // a project that no longer builds (codex P1 on cli#339).
    .bgfx = "0.21.0",
}
