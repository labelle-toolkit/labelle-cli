.{
    // The current tested-compatible set `labelle upgrade all` targets. The
    // packages version on INDEPENDENT minor trains (the assembler unifies them
    // onto the project's core at build time), so these minors differ by design.
    // Bump to the latest releases as they're cut + CI-verified together.
    .core = "2.1.0",
    .engine = "3.4.1",
    .gfx = "2.2.0",
    // No backend package pin (RFC cli#471 D4): `upgrade all` delegates the
    // backend bump to `labelle-assembler upgrade backend`, which pairs it
    // with gfx through its own version floors.
}
