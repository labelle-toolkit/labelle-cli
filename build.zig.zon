.{
    .fingerprint = 0xa3d95bf7b905a401,
    .name = .labelle_cli,
    .version = "1.47.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Issue #217: labelle-cli is a thin driver over the standalone
        // labelle-assembler binary — it no longer compiles in the
        // assembler's `generator` module. The former `labelle_assembler`
        // package dependency (and the `flow_codegen` graph it dragged in)
        // is gone: the CLI defines its own minimal `project.labelle`
        // schema (src/cli/project_config.zig) and its own self-contained
        // assembler-binary bootstrap (src/cli/asm_cache.zig).
        .zspec = .{
            .url = "https://github.com/apotema/zspec/archive/v0.9.1.tar.gz",
            .hash = "zspec-0.9.1-jaKLbbX4AwBKANdetxzzWc3UTO0UY0lcJJzTagQHlt5K",
        },
        // `labelle pack` (#214) decodes/encodes PNG via the vendored stb
        // C sources in src/cli/ (stb_image*.h + stb_image_impl.c), wired
        // through `wireStb` in build.zig. It is NOT a Zig package, so no
        // dependency entry is needed here.
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "versions.zon",
        "src",
    },
}
