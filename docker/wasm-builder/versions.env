# Pinned toolchain of the Labelle WASM builder image (labelle-cli#529).
#
# The single source of truth: the Dockerfile sources this file in every RUN
# step that installs something, the publish workflow reads IMAGE_VERSION from
# it, and the image keeps a copy at /opt/labelle/versions.env next to the
# measured inventory (/opt/labelle/toolchain-inventory.json).
#
# Plain KEY=value lines only (sourced by sh and parsed by the workflow). No
# spaces around `=`, no quotes, no expansions.
#
# Bumping any value below is an image release: raise IMAGE_REVISION (or reset
# it to 1 when LABELLE_CLI_VERSION changes) and see
# docs/wasm-builder-image.md "Upgrading".

# Image version = <labelle CLI version>-<image revision>, e.g. 4.1.2-1. The
# CLI version leads because labelle.lock's .cli_version is what a consumer
# matches against (see "Image <-> toolkit compatibility" in the docs).
IMAGE_REVISION=1

# labelle CLI: https://releases.labelle.games/cli/v<ver>/labelle-linux-x86_64
# Same version and checksum as Flying Platform's labelle.lock (.cli_version)
# and tools/ci/ensure-tool.sh (labelle@v4.1.2).
LABELLE_CLI_VERSION=4.1.2
LABELLE_CLI_SHA256=43d84d3b19d49732646a11ad0302c4863b04bc5ee0d278679a70e4cfc1712d28

# labelle-assembler: a SEED only. The CLI still resolves the assembler from
# project.labelle's .assembler_version; when it equals this version the
# image's verified copy is put into the cache instead of a download
# (labelle-builder-check). Checksum from the release's SHA256SUMS
# (github.com/labelle-toolkit/labelle-assembler/releases/tag/v0.124.0).
LABELLE_ASSEMBLER_VERSION=0.124.0
LABELLE_ASSEMBLER_SHA256=4d169a6cf9e5dcc006294efe986c4ac02fcd24aa7806eea9b01b4ad19dd3260b

# Zig: https://ziglang.org/download/<ver>/zig-x86_64-linux-<ver>.tar.xz
# = labelle-cli's DEFAULT_ZIG_VERSION / minimum_zig_version and FP's
# ensure-tool.sh zig@0.16.0 row.
ZIG_VERSION=0.16.0
ZIG_SHA256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00

# emsdk: labelle-web's default emsdk.version and pinned tag commit
# (labelle-web src/provider/emsdk.zig default_version/default_commit, v0.4.0).
# Node comes with it (emsdk 4.0.9's linux SDK bundles node-20.18.0-64bit).
EMSDK_VERSION=4.0.9
EMSDK_COMMIT=3bcf1dcd01f040f370e10fe673a092d9ed79ebb5
EMSDK_NODE_VERSION=20.18.0
# labelle-web releases whose default emsdk.version is EMSDK_VERSION (comma
# separated, no spaces). labelle-builder-check warns when labelle.lock pins another one:
# its default may have moved, and the provider passes the image's EMSDK
# through without comparing versions.
LABELLE_WEB_VERSIONS=0.4.0

# Chromium WASM smoke: Flying Platform tools/web_smoke/requirements.txt.
# Playwright brings its own pinned Chrome for Testing headless shell (H.264
# capable), installed with its system libraries.
PLAYWRIGHT_VERSION=1.64.1
PILLOW_VERSION=11.3.0
